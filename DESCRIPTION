Package: SPAROscore
Type: Package
Title: A package to compute gene signature scores from transcriptomics data
Version: 0.1.0
Authors@R: c(
    person(
      "Venkatesh", "Kamaraj",
      email = "venkatesh.kamaraj@adelaide.edu.au",
      role = c("aut", "cre")
    )
